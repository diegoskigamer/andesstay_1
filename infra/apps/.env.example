# Copia este archivo a .env en esta misma carpeta y completa tus valores reales.
# .env NO se sube a git (ver .gitignore en la raíz).

ANDESSTAY_SECURITY_ENABLED=true
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>

COGNITO_DOMAIN=tu-dominio.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=<client id del App Client de Cognito>
COGNITO_CLIENT_SECRET=<client secret, si tu App Client lo tiene>

# IP/DNS privada de la instancia EC2 donde corre RabbitMQ (ec2-mq)
RABBITMQ_HOST=10.0.1.10
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=andesstay
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_MANAGEMENT_URL=http://10.0.1.10:15672

# IP/DNS privada de la instancia EC2 donde corre Kafka (ec2-kafka)
KAFKA_BOOTSTRAP_SERVERS=10.0.1.20:9092,10.0.1.21:9092,10.0.1.22:9092
